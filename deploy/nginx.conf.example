# Replace progress.example.com and certificate paths before enabling.
server {
    listen 80;
    server_name progress.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name progress.example.com;
    ssl_certificate /etc/letsencrypt/live/progress.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/progress.example.com/privkey.pem;
    client_max_body_size 128k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:3210;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
    }
}
